        <txttip left="8" top="14" right="475" bottom="297" content="实验目的：&#x0D;&#x0A;1.掌握通过配置Dot1q终结子接口方法实现vlan间互相访问&#x0D;&#x0A;2.深入理解vlan间互相访问的转发流程&#x0D;&#x0A;&#x0D;&#x0A;实验步骤:&#x0D;&#x0A;1.配置PC的IP与掩码&#x0D;&#x0A;2.vlan的创建与划分&#x0D;&#x0A;3.在R1上设置单臂路由&#x0D;&#x0A;&#x0D;&#x0A;本次实验需要掌握的命令:&#x0D;&#x0A;dot1q termination vid 10 //&#x0D;&#x0A;配置子接口 Dot1q 终结的单层 VLAN ID&#x0D;&#x0A;arp broadcast enable//&#x0D;&#x0A;使能终结子接口的 ARP 广播功能&#x0D;&#x0A;" fontname="Consolas" fontstyle="0" editsize="120" txtcolor="-16777216" txtbkcolor="-1" charset="1" />
        <txttip left="732" top="236" right="782" bottom="275" content="vlan2&#x0D;&#x0A;" fontname="Consolas" fontstyle="0" editsize="120" txtcolor="-16777216" txtbkcolor="-1" charset="1" />
        <txttip left="1044" top="240" right="1094" bottom="279" content="vlan3&#x0D;&#x0A;" fontname="Consolas" fontstyle="0" editsize="120" txtcolor="-16777216" txtbkcolor="-1" charset="1" />
    </txttips>
